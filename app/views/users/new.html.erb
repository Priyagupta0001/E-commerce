<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet">
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <style>
        .card-header {
            text-align: center;
            font-size: 1.5rem;
            font-weight: bold;
        }
        .login-register {
            text-align: center;
            margin-top: 10px;
        }
        .form-control::placeholder {
            color: #6c757d;
        }
        .form-label {
            margin-bottom: 0.5rem;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">Register</div>
                    <div class="card-body">
                        <form action="/users" method="post">
                            <!-- Authenticity Token -->
                            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

                            <!-- Role -->
                            <div class="form-group">
                                <label for="role_id" class="form-label">Role</label>
                                <select id="role_id" name="user[role_id]" class="form-control" required>
                                    <option value="0" <%= 'selected' if @user.role_id == 0 %>>Customer</option>
                                    <option value="1" <%= 'selected' if @user.role_id == 1 %>>Admin</option>
                                </select>
                            </div>

                            <!-- Full Name -->
                            <div class="form-group">
                                <label for="full_name" class="form-label">Full Name</label>
                                <input 
                                    type="text" 
                                    id="full_name" 
                                    name="user[full_name]" 
                                    class="form-control" 
                                    placeholder="Enter your full name" 
                                    required
                                />
                            </div>

                            <!-- Email -->
                            <div class="form-group">
                                <label for="email" class="form-label">Email</label>
                                <input 
                                    type="email" 
                                    id="email" 
                                    name="user[email]" 
                                    class="form-control" 
                                    placeholder="Enter your email" 
                                    value="<%= @user&.email %>" 
                                    required
                                />
                            </div>
                          
                            <!-- Password -->
                            <div class="form-group">
                                <label for="password" class="form-label">Password</label>
                                <input 
                                    type="password" 
                                    id="password" 
                                    name="user[password]" 
                                    class="form-control" 
                                    placeholder="Enter your password" 
                                    required
                                />
                            </div>

                            <!-- Confirm Password -->
                            <div class="form-group">
                                <label for="user_password_confirmation" class="form-label">Confirm Password</label>
                                <input 
                                    type="password" 
                                    id="user_password_confirmation" 
                                    name="user[password_confirmation]" 
                                    class="form-control" 
                                    placeholder="Re-enter your password" 
                                    required
                                />
                            </div>

                            <!-- Phone Number -->
                            <div class="form-group">
                                <label for="phone_number" class="form-label">Contact Number</label>
                                <input 
                                    type="text" 
                                    id="phone_number" 
                                    name="user[phone_number]" 
                                    class="form-control" 
                                    placeholder="Enter your contact number" 
                                    required
                                />
                            </div>

                            <!-- Submit Button -->
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary btn-lg btn-block">Register</button>
                            </div>

                            <!-- Login Redirect -->
                            <div class="login-register">
                                <a href="/sign_in">Already have an account? Sign-in</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
