<%= form_with(model: [@user, @address], local: true) do |form| %>
  <div>
    <label>Street:</label>
    <%= form.text_field :street, required: true %>
  </div>
  <div>
    <label>City:</label>
    <%= form.text_field :city, required: true %>
  </div>
  <div>
    <label>State:</label>
    <%= form.text_field :state, required: true %>
  </div>
  <div>
    <label>Country:</label>
    <%= form.text_field :country, required: true %>
  </div>
  <div>
    <label>Zip Code:</label>
    <%= form.text_field :zip_code, required: true %>
  </div>
  <div>
    <%= form.submit @address.new_record? ? "Add Address" : "Update Address" %>
  </div>
<% end %>
  