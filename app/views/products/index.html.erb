<div class="card-deck", style="margin: 20px 20px 20px; padding: 10px 10px 10px 10px; display: grid; grid-template-columns: repeat(3, 1fr);">
  <% @products.each do |product| %>
    <div class="card">
			<%= image_tag product.main_image, class: "card-img-top", alt: product.name %>
      <div class="card-body" >
        <h5 class="card-title"><%= product.name %></h5>
        <p class="card-description"><%= product.description %></p>
        <p class="card-text">Price: $<%= product.price %></p>
        <%= link_to 'Show', product_path(product), class: 'btn btn-primary' %>

         <!-- Add to Cart Button -->
         <%= button_to 'Add to Cart', add_to_cart_path(product_id: product.id), method: :post, class: 'btn btn-primary' %>
    
        <% if current_user&.role_id == 1 %>
          <%= link_to 'Edit', edit_product_path(product), class: "btn btn-warning" %>
          <%= button_to 'Delete', product_path(product), method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

