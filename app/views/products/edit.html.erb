<form action="/products/<%= @product.id %>" method="post">

  <!-- Add authenticity token for CSRF protection -->
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

  <!-- Simulate PUT/PATCH method -->
  <input type="hidden" name="_method" value="patch">

  <!-- Error messages -->
  <% if @product.errors.any? %>
    <div>
      <h2><%= pluralize(@product.errors.count, "error") %> prevented this product from being saved:</h2>
      <ul>
        <% @product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Name field -->
  <div>
    <label for="product_name">Name</label>
    <input type="text" id="product_name" name="product[name]" value="<%= @product.name %>">
  </div>

  <!-- Description field -->
  <div>
    <label for="product_description">Description</label>
    <textarea id="product_description" name="product[description]"><%= @product.description %></textarea>
  </div>

  <!-- Price field -->
  <div>
    <label for="product_price">Price</label>
    <input type="number" id="product_price" name="product[price]" step="0.01" value="<%= @product.price %>">
  </div>

  <!-- Stock Quantity field -->
  <div>
    <label for="product_stock_quantity">Stock Quantity</label>
    <input type="number" id="product_stock_quantity" name="product[stock_quantity]" value="<%= @product.stock_quantity %>">
  </div>

  <!-- Submit button -->
  <div>
    <button type="submit">Update Product</button>
  </div>
</form>
