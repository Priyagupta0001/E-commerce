<ul class="nav col-12 col-lg-auto my-2 justify-content-center my-md-0 text-small">
<%= form_with(model: @product, local: true, html: { enctype: "multipart/form-data" }) do |form| %>
  <!-- Authenticity Token -->
  <%= form.hidden_field :authenticity_token %>

  <!-- Product Fields -->
  <div>
    <%= form.label :name, 'Name' %>
    <%= form.text_field :name, required: true %>
  </div>

  <div>
    <%= form.label :description, 'Description' %>
    <%= form.text_area :description, required: true %>
  </div>

  <div>
    <%= form.label :price, 'Price' %>
    <%= form.number_field :price, step: 0.01, required: true %>
  </div>

  <div>
    <%= form.label :stock_quantity, 'Stock Quantity' %>
    <%= form.number_field :stock_quantity, required: true %>
  </div>

  <div>
    <%= form.label :main_image, 'Main Image' %>
    <%= form.file_field :main_image, accept: 'image/*' %>
  </div>

  <div>
    <%= form.label :gallery_images, 'Gallery Images' %>
    <%= form.file_field :gallery_images, accept: 'image/*', multiple: true %>
  </div>

  <div>
    <%= form.submit @product.new_record? ? "Save Product" : "Update Product" %>
  </div>
<% end %>
