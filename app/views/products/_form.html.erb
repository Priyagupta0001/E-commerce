<form action="/products" method="post" enctype="multipart/form-data">
  <!-- Authenticity Token -->
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

  <!-- Product Fields -->
  <div>
    <label for="product_name">Name</label>
    <input type="text" id="product_name" name="product[name]" required>
  </div>

  <div>
    <label for="product_description">Description</label>
    <textarea id="product_description" name="product[description]" required></textarea>
  </div>

  <div>
    <label for="product_price">Price</label>
    <input type="number" id="product_price" name="product[price]" step="0.01" required>
  </div>

  <div>
    <label for="product_stock_quantity">Stock Quantity</label>
    <input type="number" id="product_stock_quantity" name="product[stock_quantity]" required>
  </div>

  <div>
    <label for="product_main_image">Main Image</label>
    <input type="file" id="product_main_image" name="product[main_image]" accept="image/*">
  </div>

  <div>
    <label for="product_gallery_images">Gallery Images</label>
    <input type="file" id="product_gallery_images" name="product[gallery_images][]" accept="image/*" multiple>
  </div>

  <div>
    <button type="submit">Save Product</button>
    <%= link_to 'Back to Products', products_path, class: 'btn btn-secondary' %>
  </div>
</form>
