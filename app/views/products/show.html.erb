<h1><%= @product.name %></h1>
<p><%= @product.description %></p>
<p>Price: <%= number_to_currency(@product.price) %></p>
<p>Stock: <%= @product.stock_quantity %></p>

<% if @product.main_image.attached? %>
  <%= image_tag @product.main_image %>
<% end %>

<%= link_to 'Back to Products', products_path %>
