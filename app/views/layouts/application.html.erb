<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ecommerce" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    
    <!-- Add in the bootstrap in <head> -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" defer></script>

  </head>

  <body>
    <p id="notice" class="position-absolute text-white" style="top: 2px;"><%= notice %></p>
    <nav>
      <div class="px-3 py-2 bg-dark text-white">
        <div class="container">
          <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
            <a href="/" class="d-flex align-items-center my-2 my-lg-0 me-lg-auto text-white text-decoration-none">
              <svg class="bi me-2" width="40" height="32" role="img" aria-label="Bootstrap"><use xlink:href="#bootstrap"/></svg>
            </a>
            <% if current_user.present? %>
              <ul class="nav col-12 col-lg-auto my-2 justify-content-center my-md-0 text-small">
                <li>
                  <%= link_to root_path, class: "nav-link text-white" do %>
                    <svg class="bi d-block mx-auto mb-1" width="24" height="24"><use xlink:href="#home"/></svg>
                    Home
                  <% end %>
                </li>
                <li>
                  <% if current_user.role_id == 1 %> <!-- Admin check -->
                    <%= link_to new_product_path, class: "nav-link text-white" do %>
                      <svg class="bi d-block mx-auto mb-1" width="24" height="24"><use xlink:href="#grid"/></svg>
                      Create Product
                    <% end %>
                  <% end %>
                </li>
                <li>
                  <%= link_to  class: "nav-link text-white" do %>
                    <svg class="bi d-block mx-auto mb-1" width="24" height="24"><use xlink:href="#speedometer2"/></svg>
                    Orders
                  <% end %>
                </li>
                <li>
                  <%= link_to  class: "nav-link text-white" do %>
                    <svg class="bi d-block mx-auto mb-1" width="24" height="24"><use xlink:href="#table"/></svg>
                    Carts
                  <% end %>
                </li>

                  <li>
                    <%= link_to user_addresses_path(current_user), class: "nav-link text-white" do %>
                      <svg class="bi d-block mx-auto mb-1" width="24" height="24"><use xlink:href="#people-circle"/></svg>
                      Address
                    <% end %>
                  </li>
                  <li>
                    <%= button_to sign_out_path, method: :delete, class: "nav-link text-white" do %>
                      <svg class="bi d-block mx-auto mb-1" width="24" height="24"><use xlink:href="#box-arrow-right"/></svg>
                      Sign Out
                    <% end %>
                  </li>
              </ul>
            <% else %>
               <ul class="nav col-12 col-lg-auto my-2 justify-content-center my-md-0 text-small">
                <input type="button" value="Register" onclick="window.location.href='<%= register_path %>'" class="btn btn-light text-dark me-2">
                <input type="button" value="Sign in" onclick="window.location.href='<%= sign_in_path %>'" class="btn btn-primary">
               </ul>
            <% end %>
          </div>
        </div>
      </div>

    </nav>
    <%= yield %>
  </body>
</html>
