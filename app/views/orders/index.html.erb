<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order List</title>

  <style>
    /* Gradient Background */
    .gradient-custom {
      background: -webkit-linear-gradient(left, #3931af, #00c6ff);
    }

    /* Table Styling */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }

    th, td {
      text-align: left;
      padding: 12px;
      border-bottom: 1px solid #ddd;
    }

    th {
      background-color: #f8f9fa;
    }

    tr:nth-child(odd) {
      background-color: #f2f2f2;
    }

    /* Custom Button Styling */
    .btn-custom {
      padding: 8px 16px;
      font-size: 14px;
      border: none;
      border-radius: 20px;
      display: block;
      margin: 20px auto;
      width: 200px;
      background-color: #e3f2fd;
      color: #333;
      font-weight: bold;
    }

    .btn-primary {
      background-color: #1b1e21;
      color: white;
    }

    .btn-primary:hover {
      background-color: #333;
    }

    .btn-secondary {
      background-color: #495057;
      color: white;
    }

    .btn-secondary:hover {
      background-color: #333;
    }
  </style>
</head>

<body>
  <div class="col-md-9 justify-content-center" style="margin-top: 30px; margin-left: 150px;">
    <div class="card card-custom">
      <div class="card-body mt-0 mx-5">
        <div class="text-center mb-3 pb-2 mt-3">
          <h4 style="color: #1b1e21;">Your Orders</h4>
        </div>
        
        <table class="table">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Date</th>
              <th>Status</th>
              <th>Total</th>
              <th>Products</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @orders.each do |order| %>
              <tr>
                <td><%= order.id %></td>
                <td><%= order.created_at.strftime("%d-%m-%Y") %></td>
                <td><%= order.status %></td>
                <td><%= number_to_currency(order.total_price) %></td>
                <td>
                  <%= order.order_items.map { |item| item.product.name }.join(", ") %>
                </td>
                <td>
                  <%= link_to "View Details", order_path(order), class: "btn btn-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div class="text-center">
          <form action="<%= root_path %>" method="get">
            <button type="submit" class="btn btn-secondary btn-custom">Back to Home</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>

</html>
