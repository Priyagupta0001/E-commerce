<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmation</title>

  <style>
    /* Gradient Background */
    .gradient-custom {
      background: -webkit-linear-gradient(left, #3931af, #00c6ff);
    }

    /* Card Styling */
    .card-custom {
      border-bottom-left-radius: 10% 50%;
      border-top-left-radius: 10% 50%;
      background: -webkit-linear-gradient(left, #721c1cbd, #00ceff5e);
      padding: 30px;
      margin: 30px;
    }

    /* Table Styling */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }

    th, td {
      text-align: left;
      padding: 12px;
      border-bottom: 1px solid #ddd;
    }

    th {
      background-color: #f8f9fa;
    }

    tr:nth-child(even) {
      background-color: #f2f2f2;
    }

    /* Custom Button Styling */
    .btn-custom {
      padding: 8px 16px;
      font-size: 14px;
      border: none;
      border-radius: 20px;
      display: block;
      margin: 20px auto;
      width: 200px;
      background-color: #e3f2fd;
      color: #333;
      font-weight: bold;
    }

    .btn-primary {
      background-color: #1b1e21;
      color: white;
    }

    .btn-primary:hover {
      background-color: #333;
    }

    .btn-secondary {
      background-color: #495057;
      color: white;
    }

    .btn-secondary:hover {
      background-color: #333;
    }
  </style>
</head>

<body>
  <div class="col-md-9 justify-content-center" style="margin-top: 30px; margin-left: 150px;">
    <div class="card card-custom">
      <div class="card-body mt-0 mx-5">
        <div class="text-center mb-3 pb-2 mt-3">
          <h4 style="color: #1b1e21;">Order Confirmation</h4>
        </div>
        
        <p class="text-white"><strong>Order ID:</strong> <%= @order.id %></p>
        <p class="text-white"><strong>Status:</strong> <%= @order.status %></p>
        <p class="text-white"><strong>Total Price:</strong> <%= number_to_currency(@order.total_price) %></p>

        <h2 class="text-white">Order Items</h2>
        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th>Quantity</th>
              <th>Price</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% @order.order_items.each do |item| %>
              <tr>
                <td><%= item.product.name %></td>
                <td><%= item.quantity %></td>
                <td><%= number_to_currency(item.price) %></td>
                <td><%= number_to_currency(item.quantity * item.price) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <p class="text-white">Thank you for your order!</p>

        <!-- Back Button -->
        <div class="text-center">
          <form action="<%= root_path %>" method="get">
            <button type="submit" class="btn btn-secondary btn-custom">Back to Home</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>

</html>
